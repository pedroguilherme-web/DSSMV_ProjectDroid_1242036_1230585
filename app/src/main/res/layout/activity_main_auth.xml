<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">






    <!-- LINHA COM OS DOIS BOTÕES (olho + microfone) -->
    <LinearLayout
            android:id="@+id/top_buttons_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp">

        <!-- ESQUERDA: Olho -->
        <LinearLayout
                android:id="@+id/layout_playlists"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginEnd="16dp">

            <FrameLayout
                    android:layout_width="170dp"
                    android:layout_height="90dp"
                    android:background="@drawable/square">

                <ImageButton
                        android:id="@+id/btn_open_playlists"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        app:srcCompat="@drawable/eye"
                        app:tint="@android:color/white"
                        android:contentDescription="@string/ver_playlists"
                        android:padding="12dp"
                        android:scaleType="centerInside"/>
            </FrameLayout>

            <TextView
                    android:id="@+id/txt_playlists"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ver playlists"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="7dp"/>
        </LinearLayout>

        <!-- DIREITA: Microfone -->
        <LinearLayout
                android:id="@+id/layout_shazam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="16dp">

            <FrameLayout
                    android:layout_width="170dp"
                    android:layout_height="90dp"
                    android:background="@drawable/square">

                <ImageButton
                        android:id="@+id/btn_shazam"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:contentDescription="Identificar música"
                        app:srcCompat="@drawable/ic_mic_white"
                        app:tint="@android:color/white"
                        android:padding="0dp"
                        android:scaleType="fitCenter"
                        android:scaleX="0.7"
                        android:scaleY="0.7"/>

            </FrameLayout>

            <TextView
                    android:id="@+id/txt_shazam"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Identificar música"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="7dp"/>
        </LinearLayout>
    </LinearLayout>











    <!-- CARROSSEL -->
    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_trending"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintTop_toBottomOf="@id/layout_playlists"
            app:layout_constraintBottom_toTopOf="@id/search_bar_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:overScrollMode="never"/>

    <!-- SEARCH BAR -->
    <LinearLayout
            android:id="@+id/search_bar_container"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_search_pill"
            android:paddingStart="12dp"
            android:paddingEnd="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
                android:id="@+id/btn_search_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@android:color/transparent"
                app:tint="@android:color/black"
                android:contentDescription="@string/search"
                app:srcCompat="@drawable/ic_search_24" />

        <EditText
                android:id="@+id/searchInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:hint="@string/search_songs_artists"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="@android:color/black"
                android:textColorHint="#88000000"
                android:background="@android:color/transparent" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
